// package.json
{
  "name": "quickrss-proxy",
  "version": "1.0.0",
  "description": "Auto-extracting readability proxy powered by upstream BPC rules",
  "main": "server.js",
  "scripts": {
    "build": "node build-bpc-rules.js",
    "start": "node build-bpc-rules.js && node server.js",
    "dev": "node build-bpc-rules.js && node --watch server.js"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "express": "^4.19.2",
    "jszip": "^3.10.1",
    "linkedom": "^0.18.5",
    "marked": "^12.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
